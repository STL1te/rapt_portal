# Copy to .env and fill in. .env is gitignored.
RAPT_USERNAME=you@example.com
RAPT_SECRET=your-api-secret-here
DATABASE_URL=postgresql://user:password@localhost/rapt_portal
SYNC_INTERVAL_SECONDS=60
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_EXTRA_BODY_JSON={"options":{"top_k":40,"repeat_penalty":1.05,"num_ctx":32768}}
LLM_TIMEOUT_SECONDS=900
LLM_KEEP_ALIVE=30m
