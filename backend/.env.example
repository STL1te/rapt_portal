# Copy to .env and fill in. .env is gitignored.
RAPT_USERNAME=you@example.com
RAPT_SECRET=your-api-secret-here
DATABASE_URL=postgresql://user:password@localhost/rapt_portal
SYNC_INTERVAL_SECONDS=60
# Three LLM roles. WIZARD and ASSISTANT are independent; each key also works without the
# prefix (LLM_MODEL, ...) as a shared fallback for those two. VALIDATOR is different: it
# inherits every unset key from WIZARD, so it needs no configuration at all until you
# want the judge to differ.
# Recipe wizard: local fine-tuned model.
WIZARD_LLM_BASE_URL=http://host.docker.internal:11434/v1
WIZARD_LLM_API_KEY=ollama
WIZARD_LLM_MODEL=qwen3:8b
WIZARD_LLM_RESPONSE_FORMAT=auto
# Провайдерские параметры запроса: JSON-словарь или key=value через запятую
# (второе — для CasaOS, он вырезает кавычки). Для дообученной gemma на llama.cpp/ollama
# нужен reasoning_effort=none, иначе response_format включает thinking и content пуст.
WIZARD_LLM_EXTRA_BODY=
# Semantic validation judge. Unset keys inherit from WIZARD_LLM_*, so leaving this block
# empty runs the judge on the extraction model itself. Point it at a stronger model and
# every other setting still follows WIZARD — including EXTRA_BODY, which is usually wrong
# for a cloud judge: reasoning_effort=none exists to silence the local student, and a
# judge is the one call where reasoning is worth paying for. Set the key to an empty
# value (not "unset") to send nothing extra.
# VALIDATOR_LLM_BASE_URL=https://api.openai.com/v1
# VALIDATOR_LLM_API_KEY=sk-...
# VALIDATOR_LLM_MODEL=gpt-5.4-nano
# VALIDATOR_LLM_SAMPLING=none
# VALIDATOR_LLM_EXTRA_BODY=
# AI assistant: cloud model.
ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
ASSISTANT_LLM_API_KEY=sk-...
ASSISTANT_LLM_MODEL=gpt-5-mini
# none for reasoning models (no temperature/top_p, max_completion_tokens)
ASSISTANT_LLM_SAMPLING=default

LLM_TIMEOUT_SECONDS=900
